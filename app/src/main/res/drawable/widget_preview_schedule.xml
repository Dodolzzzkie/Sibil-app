<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Card background matching widget_bg_dark_glass -->
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="240dp"
                android:height="150dp" />
            <gradient
                android:angle="135"
                android:endColor="#FF1E293B"
                android:startColor="#FF0F172A"
                android:type="linear" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1.5dp"
                android:color="#5538BDF8" />
        </shape>
    </item>

    <!-- Header bar ("SIBIL CE • LIVE TIMETABLE") -->
    <item
        android:top="14dp"
        android:left="16dp"
        android:right="96dp"
        android:height="14dp">
        <shape android:shape="rectangle">
            <solid android:color="#4038BDF8" />
            <corners android:radius="7dp" />
        </shape>
    </item>

    <!-- Live badge -->
    <item
        android:top="14dp"
        android:left="168dp"
        android:right="16dp"
        android:height="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#3338BDF8" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Live Now highlight row -->
    <item
        android:top="42dp"
        android:left="16dp"
        android:right="16dp"
        android:height="42dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#FF2563EB"
                android:startColor="#FF0284C7"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Up Next class row -->
    <item
        android:top="92dp"
        android:left="16dp"
        android:right="16dp"
        android:height="42dp">
        <shape android:shape="rectangle">
            <solid android:color="#CC1E293B" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#3338BDF8" />
        </shape>
    </item>
</layer-list>
